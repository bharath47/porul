{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/css/*", "/js/*", "/vendor/*", "/*.{png,svg,ico,json}"]
  },
  "globalHeaders": {
    "Cache-Control": "no-cache",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".mjs": "text/javascript"
  },
  "responseOverrides": {
    "404": { "rewrite": "/index.html" }
  }
}
